# Copy to .env and fill in. Never commit .env.

# Which model provider: gemini or vllm
SOC_MODEL_PROVIDER=vllm

# --- Gemini (Google AI Studio). Free tier: synthetic data only. ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
# Optional overrides (check exact ids in AI Studio):
# GEMINI_MODEL_PRO=gemini-3.1-pro-preview
# GEMINI_MODEL_FLASH=gemini-3.5-flash

# --- Local vLLM (OpenAI-compatible). Start vLLM with:
#   vllm serve <model> --enable-auto-tool-choice --tool-call-parser <hermes|llama3_json|...>
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=
# VLLM_API_KEY=
# Optional per-tier models: VLLM_MODEL_PRO=, VLLM_MODEL_FLASH=
